# Environment Mode: LOCAL | SUPABASE | FIREBASE
DEPLOYMENT_MODE=LOCAL

# Server Configuration
PORT=3001
JWT_SECRET=super-secret-key-siscasrce-2026

# Database Configuration (Local PostgreSQL or Supabase Connection Pooling)
# For local SQLite/Dev: file:./dev.db
# For local PostgreSQL Docker: postgresql://postgres:postgrespassword@localhost:5432/siscasrce?schema=public
# For Supabase PostgreSQL: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="file:./dev.db"

# Supabase Free Tier Configuration (Optional when DEPLOYMENT_MODE=SUPABASE)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Free Tier Configuration (Optional when DEPLOYMENT_MODE=FIREBASE)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
